{% extends 'dashboard/base.html' %}

{% block title %}Sources - Rivo{% endblock %}

{% block content %}
<div class="min-h-screen bg-gray-50 dark:bg-gray-950">
    <!-- Navigation Bar -->
    <nav class="bg-white dark:bg-gray-900 border-b border-gray-100 dark:border-gray-800">
        <div class="max-w-7xl mx-auto px-6 lg:px-8">
            <div class="flex justify-between items-center h-14">
                <div class="flex items-center space-x-3">
                    <h1 class="text-lg font-semibold text-gray-900 dark:text-gray-100">Sources</h1>
                </div>

                <div class="flex items-center space-x-6">
                    <a href="/" class="text-sm text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 transition-colors">Dashboard</a>
                    <a id="leads-link" href="/leads/" class="text-sm text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 transition-colors" style="display: none;">Leads</a>
                    <button onclick="toggleTheme()" class="p-1.5 text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-800 rounded-md transition-colors" title="Toggle theme">
                        <svg class="w-4 h-4 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
                        </svg>
                        <svg class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
                        </svg>
                    </button>
                    <button id="logout-btn" class="p-1.5 text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-800 rounded-md transition-colors" title="Logout">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-6 lg:px-8 py-8">
        <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-lg">
            <div class="flex justify-between items-center px-6 py-4 border-b border-gray-100 dark:border-gray-800">
                <h2 class="text-base font-medium text-gray-900 dark:text-gray-100">All Sources</h2>
                <button id="refresh-btn" class="p-1.5 text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-800 rounded-md transition-colors" title="Refresh">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                    </svg>
                </button>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead>
                        <tr class="border-b border-gray-100 dark:border-gray-800">
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400">Name</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400">Source</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400">State</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400">Total</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400">Pending</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400">Valid</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400">Spam</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400">Quality</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="sources-tbody" class="divide-y divide-gray-100 dark:divide-gray-800">
                        <tr>
                            <td colspan="9" class="px-6 py-8 text-center text-sm text-gray-400 dark:text-gray-500">Loading...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</div>

<!-- Bulk Assignment Modal -->
<div id="assign-modal" class="hidden fixed inset-0 bg-black bg-opacity-40 dark:bg-opacity-60 flex items-center justify-center p-4">
    <div class="bg-white dark:bg-gray-900 rounded-lg w-full max-w-md border border-gray-200 dark:border-gray-800">
        <div class="px-6 py-4 border-b border-gray-100 dark:border-gray-800">
            <h3 class="text-base font-semibold text-gray-900 dark:text-gray-100">Bulk Assign Leads</h3>
        </div>
        <div class="p-6 space-y-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Source</label>
                <input type="text" id="modal-source-name" readonly class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-gray-700 rounded-md bg-gray-50 dark:bg-gray-800 text-gray-600 dark:text-gray-400">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Assign to User</label>
                <select id="modal-user-id" class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-gray-700 rounded-md bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-1 focus:ring-gray-400 dark:focus:ring-gray-600 focus:border-gray-400 dark:focus:border-gray-600">
                    <option value="">Select a user...</option>
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Number of Leads</label>
                <input type="number" id="modal-limit" value="100" class="w-full px-3 py-2 text-sm border border-gray-200 dark:border-gray-700 rounded-md bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-1 focus:ring-gray-400 dark:focus:ring-gray-600 focus:border-gray-400 dark:focus:border-gray-600">
            </div>
        </div>
        <div class="px-6 py-4 bg-gray-50 dark:bg-gray-800 border-t border-gray-100 dark:border-gray-800 flex justify-end space-x-3 rounded-b-lg">
            <button id="modal-cancel" class="px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-md hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
                Cancel
            </button>
            <button id="modal-confirm" class="px-4 py-2 text-sm font-medium text-white bg-gray-900 dark:bg-gray-100 dark:text-gray-900 rounded-md hover:bg-gray-800 dark:hover:bg-gray-200 transition-colors">
                Assign Leads
            </button>
        </div>
    </div>
</div>

<script>
    const token = localStorage.getItem('auth_token');
    if (!token) {
        window.location.href = '/login/';
    }

    let currentSourceId = null;
    let leadOwners = [];
    let userPermissions = {};

    // Fetch user info to get permissions
    function loadUserPermissions() {
        return fetch('/account/api/user/', {
            headers: {
                'Authorization': `Token ${token}`
            }
        })
        .then(response => response.json())
        .then(data => {
            userPermissions = data.permissions || {};
            // Show Leads link if user has permission
            if (userPermissions.can_view_leads) {
                document.getElementById('leads-link').style.display = '';
            }
        });
    }

    // Fetch lead owners (users who can be assigned leads)
    function loadLeadOwners() {
        fetch('/account/api/lead-owners/', {
            headers: {
                'Authorization': `Token ${token}`
            }
        })
        .then(response => {
            if (!response.ok) throw new Error('Failed to load users');
            return response.json();
        })
        .then(data => {
            leadOwners = data;
            const select = document.getElementById('modal-user-id');
            select.innerHTML = '<option value="">Select a user...</option>';
            data.forEach(user => {
                const displayName = user.first_name && user.last_name
                    ? `${user.first_name} ${user.last_name} (${user.username})`
                    : user.username;
                select.innerHTML += `<option value="${user.id}">${displayName}</option>`;
            });
        })
        .catch(error => {
            console.error('Error loading users:', error);
        });
    }

    // Fetch and display sources
    function loadSources() {
        fetch('/leads/api/sources/', {
            headers: {
                'Authorization': `Token ${token}`
            }
        })
        .then(response => {
            if (!response.ok) throw new Error('Unauthorized');
            return response.json();
        })
        .then(data => {
            const tbody = document.getElementById('sources-tbody');
            if (data.length === 0) {
                tbody.innerHTML = '<tr><td colspan="9" class="px-6 py-4 text-center text-gray-500 dark:text-gray-400">No sources found</td></tr>';
                return;
            }

            tbody.innerHTML = data.map(source => `
                <tr class="hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
                    <td class="px-6 py-3.5">
                        <div class="text-sm font-medium text-gray-900 dark:text-gray-100">${source.name}</div>
                        ${source.owner_details ? `<div class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">${source.owner_details.username}</div>` : ''}
                    </td>
                    <td class="px-6 py-3.5 text-sm text-gray-600 dark:text-gray-400">${source.source_type}</td>
                    <td class="px-6 py-3.5">
                        ${userPermissions.can_change_sources ? `
                            <select onchange="updateLifecycleState(${source.id}, this.value)"
                                    class="px-2.5 py-1 pr-7 text-xs font-medium border rounded-md cursor-pointer transition-colors ${
                                source.lifecycle_state === 'LIVE' ? 'border-green-200 dark:border-green-800 bg-green-50 dark:bg-green-950 text-green-700 dark:text-green-400 hover:bg-green-100 dark:hover:bg-green-900' :
                                source.lifecycle_state === 'INCUBATION' ? 'border-yellow-200 dark:border-yellow-800 bg-yellow-50 dark:bg-yellow-950 text-yellow-700 dark:text-yellow-400 hover:bg-yellow-100 dark:hover:bg-yellow-900' :
                                'border-red-200 dark:border-red-800 bg-red-50 dark:bg-red-950 text-red-700 dark:text-red-400 hover:bg-red-100 dark:hover:bg-red-900'
                            }"
                                    style="appearance: none; background-image: url('data:image/svg+xml;charset=UTF-8,%3csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 20 20%27 fill=%27currentColor%27%3e%3cpath fill-rule=%27evenodd%27 d=%27M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z%27 clip-rule=%27evenodd%27/%3e%3c/svg%3e'); background-position: right 0.3rem center; background-repeat: no-repeat; background-size: 1.2em;">
                                <option value="INCUBATION" ${source.lifecycle_state === 'INCUBATION' ? 'selected' : ''}>Incubation</option>
                                <option value="LIVE" ${source.lifecycle_state === 'LIVE' ? 'selected' : ''}>Live</option>
                                <option value="QUARANTINE" ${source.lifecycle_state === 'QUARANTINE' ? 'selected' : ''}>Quarantine</option>
                            </select>
                        ` : `
                            <span class="inline-flex px-2 py-0.5 text-xs font-medium rounded border ${
                                source.lifecycle_state === 'LIVE' ? 'bg-green-50 dark:bg-green-950 text-green-700 dark:text-green-400 border-green-200 dark:border-green-800' :
                                source.lifecycle_state === 'INCUBATION' ? 'bg-yellow-50 dark:bg-yellow-950 text-yellow-700 dark:text-yellow-400 border-yellow-200 dark:border-yellow-800' :
                                'bg-red-50 dark:bg-red-950 text-red-700 dark:text-red-400 border-red-200 dark:border-red-800'
                            }">
                                ${source.lifecycle_state}
                            </span>
                        `}
                    </td>
                    <td class="px-6 py-3.5 text-sm text-gray-600 dark:text-gray-400">${source.total_leads}</td>
                    <td class="px-6 py-3.5 text-sm text-amber-600 dark:text-amber-500">${source.pending_leads}</td>
                    <td class="px-6 py-3.5 text-sm text-emerald-600 dark:text-emerald-500">${source.valid_leads}</td>
                    <td class="px-6 py-3.5 text-sm text-rose-600 dark:text-rose-500">${source.spam_leads}</td>
                    <td class="px-6 py-3.5 text-sm font-medium ${
                        source.quality_score >= 70 ? 'text-emerald-600 dark:text-emerald-500' :
                        source.quality_score >= 40 ? 'text-amber-600 dark:text-amber-500' :
                        'text-rose-600 dark:text-rose-500'
                    }">${source.quality_score}%</td>
                    <td class="px-6 py-3.5 text-sm">
                        ${(source.lifecycle_state === 'INCUBATION' && userPermissions.can_change_sources) ? `
                            <button onclick="openAssignModal(${source.id}, '${source.name}')"
                                    class="px-3 py-1.5 text-xs font-medium text-blue-700 dark:text-blue-400 bg-blue-50 dark:bg-blue-950 border border-blue-200 dark:border-blue-800 rounded-md hover:bg-blue-100 dark:hover:bg-blue-900 transition-colors">
                                Assign
                            </button>
                        ` : `<span class="text-gray-300 dark:text-gray-600">-</span>`}
                    </td>
                </tr>
            `).join('');
        })
        .catch(error => {
            console.error('Error:', error);
            localStorage.removeItem('auth_token');
            window.location.href = '/login/';
        });
    }

    function openAssignModal(sourceId, sourceName) {
        currentSourceId = sourceId;
        document.getElementById('modal-source-name').value = sourceName;
        document.getElementById('assign-modal').classList.remove('hidden');
    }

    function closeAssignModal() {
        currentSourceId = null;
        document.getElementById('modal-user-id').value = '';
        document.getElementById('modal-limit').value = '100';
        document.getElementById('assign-modal').classList.add('hidden');
    }

    function updateLifecycleState(sourceId, newState) {
        if (!confirm(`Are you sure you want to change lifecycle state to ${newState}?`)) {
            loadSources(); // Reload to reset dropdown
            return;
        }

        fetch(`/leads/api/sources/${sourceId}/`, {
            method: 'PATCH',
            headers: {
                'Authorization': `Token ${token}`,
                'Content-Type': 'application/json',
                'X-CSRFToken': getCookie('csrftoken')
            },
            body: JSON.stringify({
                lifecycle_state: newState
            })
        })
        .then(response => {
            if (response.ok) {
                alert('State changed successfully');
                loadSources();
            } else {
                return response.json().then(data => {
                    alert('Error: ' + JSON.stringify(data));
                    loadSources();
                });
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Failed to update lifecycle state');
            loadSources();
        });
    }

    function bulkAssign() {
        const userId = document.getElementById('modal-user-id').value;
        const limit = document.getElementById('modal-limit').value;

        if (!userId) {
            alert('Please select a user');
            return;
        }

        fetch(`/leads/api/sources/${currentSourceId}/bulk_assign/`, {
            method: 'PATCH',
            headers: {
                'Authorization': `Token ${token}`,
                'Content-Type': 'application/json',
                'X-CSRFToken': getCookie('csrftoken')
            },
            body: JSON.stringify({
                assigned_to_id: parseInt(userId),
                limit: parseInt(limit)
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.assigned_count !== undefined) {
                alert(`Successfully assigned ${data.assigned_count} leads`);
                closeAssignModal();
                loadSources();
            } else {
                alert('Error: ' + JSON.stringify(data));
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Failed to assign leads');
        });
    }

    // Event listeners
    document.getElementById('refresh-btn').addEventListener('click', loadSources);
    document.getElementById('modal-confirm').addEventListener('click', bulkAssign);
    document.getElementById('modal-cancel').addEventListener('click', closeAssignModal);

    document.getElementById('logout-btn').addEventListener('click', async () => {
        await fetch('/account/api/logout/', {
            method: 'POST',
            headers: {
                'Authorization': `Token ${token}`,
                'X-CSRFToken': getCookie('csrftoken')
            }
        });
        localStorage.removeItem('auth_token');
        window.location.href = '/login/';
    });

    function getCookie(name) {
        let cookieValue = null;
        if (document.cookie && document.cookie !== '') {
            const cookies = document.cookie.split(';');
            for (let i = 0; i < cookies.length; i++) {
                const cookie = cookies[i].trim();
                if (cookie.substring(0, name.length + 1) === (name + '=')) {
                    cookieValue = decodeURIComponent(cookie.substring(name.length + 1));
                    break;
                }
            }
        }
        return cookieValue;
    }

    // Load data on page load - load permissions first, then sources
    loadUserPermissions().then(() => {
        loadLeadOwners();
        loadSources();
    });
</script>
{% endblock %}